 		data_len = q->skb ? q->buf_size
@@ -647,17 +811,92 @@ static int airoha_qdma_rx_process(struct
 			goto free_frag;
 
 		port = eth->ports[p];
+		/* XDP processing - only for first fragment */
+		if (!q->skb) {
+			struct bpf_prog *xdp_prog;
+
+			rcu_read_lock();
+			xdp_prog = rcu_dereference(port->xdp_prog);
+			if (xdp_prog) {
+				struct xdp_buff xdp;
+				u32 act;
+
+				xdp_init_buff(&xdp, q->buf_size - AIROHA_XDP_HEADROOM,
+					      &q->xdp_rxq);
+				xdp_prepare_buff(&xdp, e->buf, AIROHA_XDP_HEADROOM,
+						 len, false);
+
+				act = bpf_prog_run_xdp(xdp_prog, &xdp);
+				switch (act) {
+				case XDP_PASS:
+					break;
+				case XDP_TX:
+					airoha_xdp_tx(qdma, &xdp);
+					page_pool_recycle_direct(q->page_pool,
+								 virt_to_page(e->buf));
+					rcu_read_unlock();
+					continue;
+				case XDP_REDIRECT:
+					if (!xdp_do_redirect(port->dev, &xdp, xdp_prog))
+						xdp_flush = true;
+					page_pool_recycle_direct(q->page_pool,
+								 virt_to_page(e->buf));
+					rcu_read_unlock();
+					continue;
+				default:
+					bpf_warn_invalid_xdp_action(port->dev, xdp_prog, act);
+					fallthrough;
+				case XDP_DROP:
+					page_pool_recycle_direct(q->page_pool,
+								 virt_to_page(e->buf));
+					rcu_read_unlock();
+					continue;
+				}
+			}
+			rcu_read_unlock();
+		}
 		if (!q->skb) { /* first buffer */
 			q->skb = napi_build_skb(e->buf, q->buf_size);
 			if (!q->skb)
 				goto free_frag;
 
+			skb_reserve(q->skb, AIROHA_XDP_HEADROOM);
 			__skb_put(q->skb, len);
 			skb_mark_for_recycle(q->skb);
 			q->skb->dev = port->dev;
-			q->skb->protocol = eth_type_trans(q->skb, port->dev);
 			q->skb->ip_summed = CHECKSUM_UNNECESSARY;
 			skb_record_rx_queue(q->skb, qid);
+
+			/* Copy XDP metadata mark to skb->mark for nft/tc visibility */
+			{
+				unsigned char *meta_ptr = q->skb->data - 12;
+				if (meta_ptr >= q->skb->head) {
+					u32 magic = get_unaligned_le32(meta_ptr);
+					if (magic == 0xA1B2C3D4) {
+						q->skb->mark = get_unaligned_le32(meta_ptr + 4);
+					}
+				}
+			}
+
+			/* Derive skb->priority from IP DSCP for queue selection */
+			{
+				struct ethhdr *eh = (struct ethhdr *)q->skb->data;
+				if (ntohs(eh->h_proto) == ETH_P_IP) {
+					struct iphdr *iph = (struct iphdr *)(eh + 1);
+					if ((unsigned char *)(iph + 1) <= skb_tail_pointer(q->skb))
+						q->skb->priority = iph->tos >> 5;
+				} else if (ntohs(eh->h_proto) == ETH_P_IPV6) {
+					struct ipv6hdr *ip6h = (struct ipv6hdr *)(eh + 1);
+					if ((unsigned char *)(ip6h + 1) <= skb_tail_pointer(q->skb))
+						q->skb->priority = ipv6_get_dsfield(ip6h) >> 5;
+				}
+			}
+
+			if (lro_queue && (port->dev->features & NETIF_F_LRO) &&
+			    airoha_qdma_lro_rx_process(q, desc) < 0)
+				goto free_frag;
+
+			q->skb->protocol = eth_type_trans(q->skb, port->dev);
 		} else { /* scattered frame */
 			struct skb_shared_info *shinfo = skb_shinfo(q->skb);
 			int nr_frags = shinfo->nr_frags;
@@ -712,6 +951,9 @@ free_frag:
 	}
 	airoha_qdma_fill_rx_queue(q);
 
+	if (xdp_flush)
+		xdp_do_flush();
+
 	return done;
 }
 
